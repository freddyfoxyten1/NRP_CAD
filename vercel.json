{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "nrp-cad",
  "buildCommand": "bun run vercel:build",
  "devCommand": "bun run dev:live",
  "installCommand": "bun install",
  "outputDirectory": "artifacts/dojrp/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
