{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "dev": "bun --parallel --filter @workspace/dojrp --filter @workspace/api-server run dev",
    "dev:web": "bun --filter @workspace/dojrp run dev",
    "dev:api": "bun --filter @workspace/api-server run dev",
    "build": "bun --filter @workspace/api-server --filter @workspace/dojrp run build",
    "typecheck:libs": "bunx tsc --build",
    "typecheck": "bun run typecheck:libs && bun --filter '*' --if-present run typecheck"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@rollup/rollup-win32-x64-msvc": "4.62.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
