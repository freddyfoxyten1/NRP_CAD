{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "dev": "bun ./scripts/dev-all.mjs",
    "dev:live": "bun ./scripts/dev-live.mjs",
    "dev:web": "bun run --cwd ./artifacts/dojrp dev",
    "dev:api": "bun run --cwd ./artifacts/api-server dev",
    "preview": "bun ./scripts/dev-all.mjs",
    "preview:watch": "bun ./scripts/dev-all.mjs",
    "preview:edit": "bun ./scripts/preview-edit.mjs",
    "preview:live": "bun ./scripts/preview-live.mjs",
    "preview:build": "bun run --cwd ./artifacts/dojrp build",
    "preview:serve": "bun run --cwd ./artifacts/dojrp serve",
    "build": "bun run --cwd ./artifacts/api-server build && bun run --cwd ./artifacts/dojrp build && bun ./scripts/write-build-info.mjs",
    "migrate:mongo": "bun run --cwd ./lib/db migrate:mongo",
    "migrate:mongo:verify": "bun run --cwd ./lib/db migrate:mongo:verify",
    "db:setup": "bun --cwd ./lib/db --preload ../../scripts/load-env.mjs ./src/setup-cli.ts",
    "render:setup": "bun ./scripts/render-setup.mjs",
    "render:check": "bun ./scripts/render-setup.mjs --check",
    "supabase:deploy-stats": "bun ./scripts/supabase-deploy-stats.mjs",
    "vercel:build": "bun ./scripts/vercel-build.mjs",
    "typecheck:libs": "bunx tsc --build",
    "typecheck": "bun run typecheck:libs && bun run --cwd ./artifacts/api-server typecheck && bun run --cwd ./artifacts/dojrp typecheck && bun run --cwd ./artifacts/mockup-sandbox typecheck && bun run --cwd ./scripts typecheck",
    "test": "bun test artifacts/api-server/src/lib/google-oauth.test.ts artifacts/api-server/src/lib/google-doc-resource.test.ts artifacts/dojrp/src/lib/resource-type.test.ts artifacts/dojrp/src/lib/fetch-api-json.test.ts artifacts/dojrp/src/lib/google-doc-url.test.ts artifacts/dojrp/src/lib/persist-google-doc.test.ts artifacts/dojrp/src/lib/resource-url.test.ts"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@rollup/rollup-win32-x64-msvc": "4.62.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
