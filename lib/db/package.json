{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:mongo": "bun --preload ../../scripts/load-env.mjs ./src/migrate/run.ts",
    "migrate:mongo:verify": "bun --preload ../../scripts/load-env.mjs ./src/migrate/verify.ts",
    "purge:untitled-dps-ranks": "bun --preload ../../scripts/load-env.mjs ./src/maintenance/purge-untitled-dps-ranks.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "ioredis": "^5.6.1",
    "mongodb": "^6.16.0",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
