# Copy this file to .env and fill in your values.
#
# GitHub / VPS (cad.dojrblx.com) uses MongoDB Atlas only.
# Do not set DATA_STORE=sql and do not use cad-database SQLite in production.
#
# NODE_ENV=production
# DATA_STORE=mongo
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=dojcad
# DISCORD_REDIRECT_URI=https://cad.dojrblx.com/dojcad/discord-callback
# CORS_ORIGIN=https://cad.dojrblx.com
# PUBLIC_ORIGIN=https://cad.dojrblx.com
# REDIS_URL=redis://127.0.0.1:6379

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1539452857592324116
DISCORD_SERVER_NAME=Northpoint Roleplay
DISCORD_INVITE_CODE=
# DISCORD_INVITE_URL=https://discord.gg/yourcode
# Local dev only — production must use https://cad.dojrblx.com/dojcad/discord-callback
DISCORD_REDIRECT_URI=http://localhost:5173/dojcad/discord-callback
STAFF_DISCORD_GUILD_ID=1539452857592324116
DPS_DISCORD_GUILD_ID=1539452857592324116
DIVISION_DISCORD_GUILD_ID=1539452857592324116
DPH_DISCORD_GUILD_ID=1539452857592324116
DISCORD_GATEWAY_ENABLED=1
DISCORD_SYNC_DEBOUNCE_MS=2000
DISCORD_SYNC_MAX_WAIT_MS=8000
DISCORD_ROLES_CACHE_TTL_MS=120000
STAFF_SYNC_INTERVAL_MS=60000
DPS_SYNC_INTERVAL_MS=60000
DPH_SYNC_INTERVAL_MS=60000
# Optional Postgres URL for one-time ETL only — never the GitHub/VPS runtime store
# Supabase / Neon Postgres (SQL mode). Always include sslmode=require.
# Direct db.*.supabase.co is IPv6-only. On most home networks use the IPv4 session pooler
# from Dashboard → Connect (user is postgres.PROJECT_REF, host aws-0-REGION.pooler.supabase.com:5432):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Required: MongoDB Atlas is the only database on GitHub and the VPS
DATA_STORE=mongo
MONGODB_URI=
MONGODB_DATABASE=dojcad
REDIS_URL=
SUPERADMIN_DISCORD_IDS=
ERLC_API_KEY=
# Change in production — do not use the example default
ADMIN_PORTAL_CODE=
# Comma-separated allowed browser origins (production). Defaults to https://cad.dojrblx.com
CORS_ORIGIN=
PUBLIC_ORIGIN=
WEB_PORT=5173
API_PORT=8080
VITE_SERVER_STORE_URL=
# Google Docs live resources (OAuth). Redirect must also be added in Google Cloud.
# Local/preview: http://localhost:4173/dojcad/google-callback
# Production: https://cad.dojrblx.com/dojcad/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/dojcad/google-callback
