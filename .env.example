# Copy this file to .env and fill in your values.
#
# ── Production (cad.dojrblx.com / VPS) ─────────────────────────────────────
# Required on the server — never use SQLite or localhost URLs in production.
#
# NODE_ENV=production
# DATA_STORE=mongo
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=dojcad
# DISCORD_REDIRECT_URI=https://cad.dojrblx.com/dojcad/discord-callback
# CORS_ORIGIN=https://cad.dojrblx.com
# PUBLIC_ORIGIN=https://cad.dojrblx.com
# REDIS_URL=redis://127.0.0.1:6379
#
# ── Local development only ─────────────────────────────────────────────────
# Use DATA_STORE=sql when MONGODB_URI is unset, or point MONGODB_URI at Atlas.
# DATA_STORE=sql

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=823606319529066548
DISCORD_SERVER_NAME=DOJRP
DISCORD_INVITE_CODE=
# DISCORD_INVITE_URL=https://discord.gg/yourcode
# Local dev only — production must use https://cad.dojrblx.com/dojcad/discord-callback
DISCORD_REDIRECT_URI=http://localhost:5173/dojcad/discord-callback
STAFF_DISCORD_GUILD_ID=1411760639428399194
DPS_DISCORD_GUILD_ID=1469131277612486791
DIVISION_DISCORD_GUILD_ID=1469131277612486791
DPH_DISCORD_GUILD_ID=1519857439220957204
DISCORD_GATEWAY_ENABLED=1
DISCORD_SYNC_DEBOUNCE_MS=2000
DISCORD_SYNC_MAX_WAIT_MS=8000
DISCORD_ROLES_CACHE_TTL_MS=120000
STAFF_SYNC_INTERVAL_MS=60000
DPS_SYNC_INTERVAL_MS=60000
DPH_SYNC_INTERVAL_MS=60000
# Optional Postgres URL for ETL source only — not used at runtime when DATA_STORE=mongo
DATABASE_URL=
# Production: mongo + MONGODB_URI (required). Local dev without Atlas: DATA_STORE=sql
DATA_STORE=mongo
MONGODB_URI=
MONGODB_DATABASE=dojcad
REDIS_URL=
SUPERADMIN_DISCORD_IDS=
ERLC_API_KEY=
# Change in production — do not use the example default
ADMIN_PORTAL_CODE=
# Comma-separated allowed browser origins (production). Defaults to https://cad.dojrblx.com
CORS_ORIGIN=
PUBLIC_ORIGIN=
WEB_PORT=5173
API_PORT=8080
VITE_SERVER_STORE_URL=
