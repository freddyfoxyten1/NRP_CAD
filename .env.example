# Copy this file to .env and fill in your values.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=823606319529066548
# Display name + invite shown when someone signs in without being in the server
DISCORD_SERVER_NAME=DOJRP
DISCORD_INVITE_CODE=
# Or a full invite URL: https://discord.gg/yourcode
# DISCORD_INVITE_URL=
# Dev (`bun run dev`) — also add http://localhost:4173/dojcad/discord-callback for preview (`bun run preview`)
DISCORD_REDIRECT_URI=http://localhost:5173/dojcad/discord-callback
STAFF_DISCORD_GUILD_ID=1411760639428399194
DPS_DISCORD_GUILD_ID=1469131277612486791
# Optional override; defaults to DPS_DISCORD_GUILD_ID
DIVISION_DISCORD_GUILD_ID=1469131277612486791
DPH_DISCORD_GUILD_ID=1519857439220957204
# Realtime roster sync via Discord Gateway (role add/remove → roster update in ~2–8s)
DISCORD_GATEWAY_ENABLED=1
DISCORD_SYNC_DEBOUNCE_MS=2000
DISCORD_SYNC_MAX_WAIT_MS=8000
# Discord role dropdown cache (ms); Gateway invalidates on role create/update/delete
DISCORD_ROLES_CACHE_TTL_MS=120000
# Fallback poll if Gateway disconnects (minimum 10s)
STAFF_SYNC_INTERVAL_MS=60000
DPS_SYNC_INTERVAL_MS=60000
DPH_SYNC_INTERVAL_MS=60000
# Optional Postgres URL for SQL-mode / ETL source. Leave empty for local SQLite ETL source.
DATABASE_URL=
# Persistent store: mongo (preferred) or sql.
# If unset: uses mongo whenever MONGODB_URI is set, otherwise sql.
DATA_STORE=mongo
# MongoDB Atlas — required for normal website/API operation
MONGODB_URI=
MONGODB_DATABASE=dojcad
# Redis for admin member list caching (recommended)
REDIS_URL=
# Optional: comma-separated Discord IDs with full CAD access (in addition to builtins)
SUPERADMIN_DISCORD_IDS=
ERLC_API_KEY=
ADMIN_PORTAL_CODE=ADMIN2026
WEB_PORT=5173
API_PORT=8080
# Optional public store URL (fallback if not set in Admin → Server Store)
VITE_SERVER_STORE_URL=
